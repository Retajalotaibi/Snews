# Server configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# Database configuration
# Local MongoDB (active on macOS)
MONGODB_URI=mongodb://127.0.0.1:27017/marketlens
MONGODB_DB_NAME=marketlens

# If using MongoDB Atlas cloud database:
# 1. In MongoDB Atlas, go to Network Access -> Add IP Address -> Select "Allow Access From Anywhere" (0.0.0.0/0)
# 2. Set your cluster URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marketlens?retryWrites=true&w=majority

# Local PostgreSQL (optional)
DATABASE_URL=postgresql://kunbun@localhost:5432/postgres

# External APIs
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
