# ============================================================
# MarketLens — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# Server (only used when running locally / on Render)
PORT=5001
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas connection string
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. In "Network Access" add 0.0.0.0/0 to allow all IPs (required for Vercel/Render)
# 3. Create a database user and copy the connection string below
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marketlens?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=marketlens

# NewsAPI — get a free key at https://newsapi.org
NEWS_API_KEY=

# Alpha Vantage — get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
